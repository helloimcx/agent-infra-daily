{
  "schema_version": "2.2.0",
  "purpose": "Type-specific content schema for first-party entity knowledge pages.",
  "common": [
    "summary",
    "intro",
    "why_it_matters",
    "themes",
    "maturity",
    "first_seen",
    "last_verified",
    "page",
    "content_mode",
    "content_version"
  ],
  "types": {
    "Project": [
      "definition",
      "operating_model",
      "key_capabilities",
      "architecture_role",
      "limitations",
      "maturity_notes",
      "engineering_takeaways",
      "what_to_watch",
      "architecture_flow"
    ],
    "Capability": [
      "definition",
      "problem_it_solves",
      "core_mechanisms",
      "representative_implementations",
      "engineering_considerations",
      "failure_modes",
      "design_space"
    ],
    "Research": [
      "research_question",
      "method",
      "findings",
      "limitations",
      "engineering_implications",
      "what_to_watch",
      "evidence_scope"
    ],
    "Standard": [
      "purpose",
      "core_mechanisms",
      "ecosystem_impact",
      "migration_notes",
      "what_to_watch"
    ],
    "Pattern": [
      "problem",
      "mechanism",
      "when_to_use",
      "tradeoffs",
      "engineering_takeaways"
    ],
    "Trend": [
      "thesis",
      "supporting_signals",
      "counter_signals",
      "what_to_watch",
      "confidence_note",
      "falsification_conditions"
    ]
  },
  "authoring_rules": [
    "intro and why_it_matters must be explicitly authored for the individual entity.",
    "Do not generate prose by concatenating type, theme, relationship, maturity or architecture fields.",
    "Graph relationships may support factual checking and UI, but must not be used as a prose template.",
    "Core entity types must use their type-specific structured fields.",
    "External URLs are evidence, never substitutes for first-party entity content."
  ]
}